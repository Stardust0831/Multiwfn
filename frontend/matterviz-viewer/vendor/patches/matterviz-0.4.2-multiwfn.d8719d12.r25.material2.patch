+const OUTPUT_CHUNK = `#include <opaque_fragment>`;
+const UNIFORMS = `
+uniform float mvOutline;
+uniform float mvOutlineWidth;
+uniform float mvTransmode;
+`;
+const SHADING = `
+// Three's geometryViewDir includes the orthographic-camera correction.
+float mvFacing = clamp(dot(normal, geometryViewDir), 0.0, 1.0);
+float mvRim = pow(max(0.0, 1.0 - mvFacing * mvFacing), max(0.001, (1.0 - mvOutlineWidth) * 32.0));
+gl_FragColor.rgb *= 1.0 - mvOutline * mvRim;
+if (mvTransmode > 0.5 && gl_FragColor.a > 0.0 && gl_FragColor.a < 1.0) {
+  float mvAlpha = 1.0 + cos(3.14159265 * (1.0 - gl_FragColor.a) * mvFacing);
+  gl_FragColor.a = mvAlpha * mvAlpha * 0.25;
+}
+`;
+const bounded = (value, fallback) => Number.isFinite(value)
+    ? Math.min(1, Math.max(0, value))
+    : fallback;
+
+// onBeforeCompile sees unexpanded ShaderLib includes, not ShaderChunk output.
+// Keep the standard output chunk for opaque/transmission handling, then shade
+// in linear space before tone mapping, output color conversion and fog.
+export function install_isosurface_shading(material, settings) {
+    material.onBeforeCompile = (shader) => {
+        if (!shader.fragmentShader.includes(OUTPUT_CHUNK)) {
+            throw new Error(`Unsupported Three shader: missing isosurface output chunk`);
+        }
+        shader.uniforms.mvOutline = { value: bounded(settings.outline, 0) };
+        shader.uniforms.mvOutlineWidth = { value: bounded(settings.outlineWidth, 0.6) };
+        shader.uniforms.mvTransmode = { value: settings.transmode === 1 ? 1 : 0 };
+        shader.fragmentShader = UNIFORMS + shader.fragmentShader.replace(
+            OUTPUT_CHUNK,
+            OUTPUT_CHUNK + SHADING,
+        );
+    };
+    material.customProgramCacheKey = () => `multiwfn-isosurface-material-v1`;
+    material.needsUpdate = true;
+}
