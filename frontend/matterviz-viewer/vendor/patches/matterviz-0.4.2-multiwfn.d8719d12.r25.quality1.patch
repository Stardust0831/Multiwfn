+// Scene-local geometry readiness. WeakMap identity excludes borrowed mesh clones.
+export const geometry_states = new WeakMap();
+export function isosurface_geometry_states(root) {
+    const states = [];
+    root.traverse((object) => {
+        const read = geometry_states.get(object);
+        if (read) states.push(read());
+    });
+    return states;
+}
+
+// Call after the UI has flushed its requested settings. Two stable render frames
+// also let materials and consumers of borrowed geometry catch up before export.
+export async function wait_for_isosurface_geometry(root, quality = `source`, timeout = 60000) {
+    const deadline = performance.now() + timeout;
+    let previous = [];
+    let stable_frames = 0;
+    while (performance.now() < deadline) {
+        await new Promise((resolve) => requestAnimationFrame(resolve));
+        const states = isosurface_geometry_states(root);
+        const error = states.find((state) => state.status === `error`);
+        if (error) throw new Error(error.error || `Isosurface geometry is unavailable`);
+        if (states.every((state) => state.status === `ready` && state.quality === quality)) {
+            const unchanged = states.length === previous.length && states.every((state, idx) => state === previous[idx]);
+            stable_frames = unchanged ? stable_frames + 1 : 0;
+            if (stable_frames >= 2) return states;
+        } else stable_frames = 0;
+        previous = states;
+    }
+    throw new Error(`Timed out waiting for ${quality}-quality isosurfaces; no image was exported`);
+}
