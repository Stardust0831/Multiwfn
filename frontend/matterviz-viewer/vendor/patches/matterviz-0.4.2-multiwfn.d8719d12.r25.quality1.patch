+import type { Object3D } from 'three';
+import type { Vec3 } from '../math';
+export interface IsosurfaceGeometryState {
+    revision: number;
+    status: `pending` | `ready` | `error`;
+    quality: `source` | `preview`;
+    grids: { source: Vec3; effective: Vec3 }[];
+    error?: string;
+}
+export declare const geometry_states: WeakMap<Object3D, () => IsosurfaceGeometryState>;
+export declare function isosurface_geometry_states(root: Object3D): IsosurfaceGeometryState[];
