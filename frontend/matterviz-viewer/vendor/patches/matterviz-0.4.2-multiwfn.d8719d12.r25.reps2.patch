+// Editable continuous color scales. Positions use [0, 1] of the scalar range;
+// colors interpolate in sRGB, then the renderer converts to linear vertex RGB.
+export const MAX_COLOR_STOPS = 32;
+export function normalize_color_stops(value) {
+    if (!Array.isArray(value) || value.length < 2 || value.length > MAX_COLOR_STOPS)
+        throw new Error(`Use between 2 and 32 color stops`);
+    const stops = value.map((stop) => {
+        if (!stop || typeof stop.position !== `number` || !Number.isFinite(stop.position)
+            || stop.position < 0 || stop.position > 1)
+            throw new Error(`Color stop positions must be between 0% and 100%`);
+        if (typeof stop.color !== `string` || !/^#[0-9a-f]{6}$/i.test(stop.color))
+            throw new Error(`Use a six-digit hex color for each stop`);
+        return { position: stop.position, color: stop.color.toLowerCase() };
+    }).sort((a, b) => a.position - b.position);
+    if (stops.some((stop, index) => index > 0 && stop.position <= stops[index - 1].position))
+        throw new Error(`Color stop positions must be distinct`);
+    return stops;
+}
+export function color_stop_interpolator(value) {
+    const stops = normalize_color_stops(value);
+    const colors = stops.map(({ color }) => {
+        const hex = Number.parseInt(color.slice(1), 16);
+        return [(hex >> 16) / 255, ((hex >> 8) & 255) / 255, (hex & 255) / 255];
+    });
+    return (position, out = [0, 0, 0]) => {
+        const t = Number.isFinite(position) ? position : 0.5;
+        let right = stops.findIndex((stop) => stop.position >= t);
+        if (right < 0) right = stops.length - 1;
+        const left = Math.max(0, right - 1);
+        const span = stops[right].position - stops[left].position;
+        const fraction = span > 0 ? Math.max(0, Math.min(1, (t - stops[left].position) / span)) : 0;
+        for (let channel = 0; channel < 3; channel++)
+            out[channel] = colors[left][channel] + (colors[right][channel] - colors[left][channel]) * fraction;
+        return out;
+    };
+}
+export function color_stop_hex(stops, position) {
+    return `#` + color_stop_interpolator(stops)(position)
+        .map((channel) => Math.round(channel * 255).toString(16).padStart(2, `0`)).join(``);
+}
+export function color_stops_gradient(stops, direction = `to right`) {
+    return `linear-gradient(${direction} in srgb, ${normalize_color_stops(stops)
+        .map(({ position, color }) => `${color} ${position * 100}%`).join(`, `)})`;
+}
