+export const interpolateTransFlag = (t) => {
+    const value = clamp01(t);
+    const start = value <= 0.5 ? [245, 169, 184] : [255, 255, 255];
+    const end = value <= 0.5 ? [255, 255, 255] : [91, 206, 250];
+    const fraction = value <= 0.5 ? value * 2 : (value - 0.5) * 2;
+    return rgb(...start.map((channel, idx) => channel + (end[idx] - channel) * fraction)).formatHex();
+};
