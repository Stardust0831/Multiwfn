+import { BufferAttribute, BufferGeometry, Uint32BufferAttribute } from 'three';
+
+// Share the legacy path's area-weighted Cartesian normals. Marching-cubes
+// gradients are sampled at grid endpoints in index coordinates, so directly
+// rendering them gives incorrect lighting for rotated or anisotropic grids.
+export function build_typed_geometry(result) {
+    if (result.positions.length === 0 || result.indices.length === 0) return null;
+    const geometry = new BufferGeometry();
+    geometry.setAttribute(`position`, new BufferAttribute(result.positions, 3));
+    geometry.setIndex(new Uint32BufferAttribute(result.indices, 1));
+    // Reuse the worker's budgeted allocation; computeVertexNormals clears and
+    // overwrites it. Triangle winding remains unchanged, including reflections.
+    if (result.normals?.length === result.positions.length)
+        geometry.setAttribute(`normal`, new BufferAttribute(result.normals, 3));
+    geometry.computeVertexNormals();
+    geometry.computeBoundingSphere();
+    return geometry;
+}
