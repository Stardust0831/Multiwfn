+export const TRANS_FLAG_STOPS = [`#f5a9b8`, `#ffffff`, `#5bcefa`];
+const lerp_css_hex = (first, second, fraction) => {
+    const parse = (hex) => {
+        const value = Number.parseInt(hex.replace(`#`, ``), 16);
+        return [(value >> 16) & 255, (value >> 8) & 255, value & 255];
+    };
+    const first_rgb = parse(first);
+    const second_rgb = parse(second);
+    const amount = Math.min(1, Math.max(0, fraction));
+    const channels = first_rgb.map((channel, index) => Math.round(channel + (second_rgb[index] - channel) * amount));
+    return `#${channels.map((channel) => channel.toString(16).padStart(2, `0`)).join(``)}`;
+};
+export const trans_flag_interpolator = (value) => {
+    const amount = Math.min(1, Math.max(0, value));
+    const [negative, zero, positive] = TRANS_FLAG_STOPS;
+    return amount < 0.5
+        ? lerp_css_hex(negative, zero, amount * 2)
+        : lerp_css_hex(zero, positive, (amount - 0.5) * 2);
+};
 export const get_d3_interpolator = (name) => {
+    if (name === `interpolateTransFlag`)
+        return trans_flag_interpolator;
     const candidate = d3_sc[name];
     return typeof candidate === `function` ? candidate : d3_sc.interpolateViridis;
 };
