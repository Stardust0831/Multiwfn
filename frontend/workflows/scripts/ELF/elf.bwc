wfn=*.fchk
plane=?

[grid]
%process
    elf
%command
#!/bin/bash
mkdir -p "${input}_ELF"
mv ELF.cub "${input}_ELF/${input}_elf.cub"
cat << EOF > "${input}_ELF/elf.bat"
vmd -e elf.vmd
EOF
cat << EOF2 > "${input}_ELF/elf.vmd"
vcube ${input}_elf.cub
EOF2
mv "${output}" "${input}_ELF"
end

wfn_rebase=${input}_ELF/${input}_elf.cub
[plane_fromcub]
%process
    autoplot plane ${plane}
%command
#!/bin/bash
mv dislin.png plane.txt "${output}" "${input}_ELF"
end


